# Copy to .env.local and fill in. Never commit .env.local.

# ─── WooCommerce / WordPress ─────────────────────────────
NEXT_PUBLIC_WP_URL=https://your-wp-site.com
NEXT_PUBLIC_WC_API_URL=https://your-wp-site.com/wp-json/wc/v3
WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Razorpay ────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# ─── Google Analytics 4 ──────────────────────────────────
# Admin → Data streams → your web stream → "Measurement ID"
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Meta Pixel + Conversions API ────────────────────────
# Events Manager → Data sources → your pixel → the numeric ID under its name
NEXT_PUBLIC_META_PIXEL_ID=000000000000000
# Events Manager → your pixel → Settings → Conversions API → Generate access token
# Server-only. Treat it like a password — it can write events to your ad account.
META_CAPI_ACCESS_TOKEN=
# Optional: while testing, paste the code from Events Manager → Test events.
# Events sent with this land in the test view only. REMOVE IT BEFORE GOING LIVE.
META_CAPI_TEST_EVENT_CODE=
# Optional: pin the Graph API version (defaults to v21.0)
META_GRAPH_API_VERSION=v21.0
